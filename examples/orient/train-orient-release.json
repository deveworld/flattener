{
  "data": "${FLATTENER_CACHE}/orient-release-v1",
  "output_dir": "${FLATTENER_RUNS}/orient-v1",
  "track": "release",
  "init": "scratch",
  "seed": 0,
  "batch_size": 128,
  "total_steps": 16000,
  "lr": 0.002,
  "weight_decay": 0.05,
  "warmup_steps": 500,
  "min_lr_ratio": 0.01,
  "label_smoothing": 0.05,
  "aux_weight": 0.3,
  "grad_clip": 2.0,
  "amp": true,
  "num_workers": 10,
  "prefetch_factor": 4,
  "device": "cuda",
  "log_every": 50,
  "val_every": 1000,
  "val_batch_size": 256,
  "checkpoint_every": 1000,
  "keep_checkpoints": 2,
  "max_silent_error": 0.005
}
