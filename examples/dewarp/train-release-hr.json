{
  "data_spec": "data-release-raw.json",
  "output_dir": "${FLATTENER_RUNS}/hires-1440-finetune",
  "track": "release",
  "model": {"input_size": [1440, 1024], "grid_size": [90, 64]},
  "init": "checkpoint",
  "init_path": "${FLATTENER_INIT_CHECKPOINT}",
  "seed": 0,
  "batch_size": 32,
  "total_steps": 37500,
  "lr": 0.00005,
  "weight_decay": 0.0001,
  "schedule": "cosine",
  "warmup_steps": 1000,
  "grad_clip": 1.0,
  "loss_grid2d": 5.0,
  "loss_grid3d": 5.0,
  "loss_recon": 1.0,
  "recon_start_step": 0,
  "augment": {"margin": [0.0, 0.08], "full_frame_prob": 0.1, "rotation_deg": 15.0, "rotation_prob": 0.3},
  "num_workers": 14,
  "channels_last": true,
  "device": "cuda",
  "val_every": 3750,
  "val_batch_size": 16,
  "val_views": [
    {"name": "page", "crop": "page", "margin": [0.04, 0.04]},
    {"name": "docunet", "crop": "page", "margin": [0.02, 0.1]}
  ],
  "val_select": "docunet",
  "checkpoint_every": 3750,
  "keep_checkpoints": 2
}
