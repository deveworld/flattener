{
  "data_spec": "data-release-uvdoc-half.json",
  "output_dir": "${FLATTENER_RUNS}/uvdoc-half-ft-1",
  "track": "release",
  "model": {
    "input_size": [
      712,
      488
    ],
    "grid_size": [
      45,
      31
    ]
  },
  "init": "checkpoint",
  "init_path": "${FLATTENER_INIT_CHECKPOINT}",
  "seed": 1,
  "batch_size": 32,
  "total_steps": 40000,
  "lr": 5e-05,
  "weight_decay": 0.0001,
  "schedule": "cosine",
  "warmup_steps": 1000,
  "grad_clip": 1.0,
  "loss_grid2d": 5.0,
  "loss_grid3d": 0.0,
  "loss_recon": 1.0,
  "recon_start_step": 0,
  "augment": {
    "margin": [
      0.0,
      0.08
    ],
    "full_frame_prob": 0.1,
    "rotation_deg": 15.0,
    "rotation_prob": 0.3,
    "composite": {
      "prob": 0.4,
      "area": [
        0.05,
        1.0
      ],
      "overhang": 0.02,
      "perspective": 0.12,
      "turns": [
        1,
        0,
        0,
        0
      ],
      "neighbor_prob": 0.6,
      "background_dir": "${FLATTENER_CACHE}/backgrounds/polyhaven-768"
    }
  },
  "num_workers": 8,
  "channels_last": false,
  "device": "cuda",
  "max_seconds": 16200,
  "val_every": 4000,
  "val_batch_size": 16,
  "val_views": [
    {
      "name": "page",
      "crop": "page",
      "margin": [
        0.04,
        0.04
      ]
    },
    {
      "name": "docunet",
      "crop": "page",
      "margin": [
        0.02,
        0.1
      ]
    },
    {
      "name": "tilt15",
      "crop": "tilt",
      "margin": [
        0.02,
        0.1
      ],
      "tilt": 0.15
    }
  ],
  "val_select": "docunet",
  "checkpoint_every": 4000,
  "keep_checkpoints": 2
}
