{
  "data_spec": "data-release.json",
  "output_dir": "${FLATTENER_RUNS}/uvdoc-init-s0",
  "track": "release",
  "model": {"input_size": [712, 488], "grid_size": [45, 31]},
  "init": "uvdoc",
  "init_path": "${FLATTENER_UVDOC_WEIGHTS}",
  "seed": 0,
  "batch_size": 32,
  "total_steps": 62500,
  "lr": 0.0002,
  "weight_decay": 0.0001,
  "schedule": "cosine",
  "warmup_steps": 1000,
  "grad_clip": 1.0,
  "loss_grid2d": 5.0,
  "loss_grid3d": 5.0,
  "loss_recon": 1.0,
  "recon_start_step": 31250,
  "augment": {"margin": [0.0, 0.08], "full_frame_prob": 0.1, "rotation_deg": 15.0, "rotation_prob": 0.3},
  "num_workers": 8,
  "device": "cuda",
  "val_every": 2500,
  "val_batch_size": 16,
  "val_views": [
    {"name": "page", "crop": "page", "margin": [0.04, 0.04]},
    {"name": "docunet", "crop": "page", "margin": [0.02, 0.1]},
    {"name": "full_frame", "crop": "full_frame"},
    {"name": "rot90", "crop": "page", "margin": [0.02, 0.1], "rotation": 90},
    {"name": "rot270", "crop": "page", "margin": [0.02, 0.1], "rotation": 270},
    {"name": "small_page", "crop": "small_page", "margin": [0.02, 0.1], "page_fraction": [0.1, 0.25]}
  ],
  "val_select": "docunet",
  "checkpoint_every": 2500
}
