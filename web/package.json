{
  "name": "flattener-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "npm run build && wrangler dev",
    "test": "node --import tsx --test tests/*.test.ts",
    "deploy:cloudflare": "npm run build && node scripts/cloudflare.mjs dist cloudflare && npx --yes wrangler@4 deploy",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "onnxruntime-web": "1.23.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "wrangler": "^4.147.0"
  }
}
